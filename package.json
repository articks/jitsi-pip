{
  "name": "jitsi-meet-pip",
  "version": "1.2.12",
  "private": true,
  "description": "Standalone multi-participant Picture-in-Picture plugin for Jitsi Meet",
  "author": "Dmitry Karasev <articks@gmail.com> (https://github.com/articks)",
  "license": "MIT",
  "homepage": "https://github.com/articks/jitsi-pip#readme",
  "bugs": {
    "url": "https://github.com/articks/jitsi-pip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/articks/jitsi-pip.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node scripts/check-jitsi-contract.mjs",
    "test:dist": "node scripts/check-dist.mjs",
    "check": "npm run typecheck && npm run test && npm run test:contract && npm run build && npm run test:dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
