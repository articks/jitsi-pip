# Local-only Jitsi test environment. Do not use these values in production.
CONFIG=/absolute/path/to/jitsi-pip/test/jitsi/config
PIP_PROJECT_DIR=/absolute/path/to/jitsi-pip

JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11146-1
RESTART_POLICY=no
TZ=Europe/Moscow

HTTP_PORT=127.0.0.1:18000
HTTPS_PORT=127.0.0.1:18443
PUBLIC_URL=https://127.0.0.1:18443

DISABLE_HTTPS=0
BOSH_RELATIVE=1
ENABLE_HTTP_REDIRECT=0
ENABLE_HSTS=0
ENABLE_LETSENCRYPT=0
ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=1
ENABLE_CLOSE_PAGE=0
ENABLE_P2P=0
ENABLE_XMPP_WEBSOCKET=0
DISABLE_DEEP_LINKING=1
DEFAULT_LANGUAGE=ru

XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_PORT=5222

JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=replace-with-local-random-value
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=replace-with-another-local-random-value
JVB_PORT=10000
JVB_ADVERTISE_IPS=127.0.0.1#11000
JVB_DISABLE_STUN=true
JICOFO_REST_PORT=18888
JVB_COLIBRI_PORT=18080
